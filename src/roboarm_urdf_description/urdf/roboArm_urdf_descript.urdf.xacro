<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Robot_Arm" >

    <link name="world"/>  

    <!-- base link of the robotarm -->
    <link name="base_link">    
        <xacro:default_inertial_matrix mass="1.0"/>
        <visual>
           <origin rpy="0 0 0" xyz= "0 0 .175"/>
            <geometry>
                <box size="0.5 0.5 0.34"/>
            </geometry>
        </visual>
        <!-- for Gazebo -->
        <collision>      
            <origin rpy="0 0 0" xyz= "0 0 .175"/> 
            <geometry>
                <box size="0.5 0.5 0.34"/>
            </geometry>
        </collision>
    </link>

    <joint name="virtual_joint" type="fixed"> <!-- virtual_joint -->
        <parent link="world"/>      
        <child link="base_link"/>   
        <origin rpy="0 0 0" xyz="0 0 0"/> 
    </joint>

    <link name="base_plate">   
        <xacro:default_inertial_matrix mass="0.1"/> 
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0.176"/>
            <geometry>
                <box size="0.12 0.12 0.35"/>
            </geometry>
        </visual>

        <collision>      
            <origin rpy="0 0 0" xyz="0 0 0.176"/>
            <geometry>
                <box size="0.12 0.12 0.35"/>
            </geometry>
        </collision>
    </link>

    <joint name="joint-1" type="revolute"> 
        <parent link="base_link"/>
        <child link="base_plate"/>
        <axis xyz="0 0 1"/> 
        <origin rpy="0 0 0" xyz="0.0 0.0 0.35"/>
        <limit lower="-${PI}" upper="${PI}" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <link name="biceps_link"> 
        <xacro:default_inertial_matrix mass="0.1"/>
        <visual>
            <origin rpy="0 -${PI/2} ${PI/2}" xyz="0.1 0.0 0.5"/>
            <geometry>
                <box size="1.0 0.2 0.2"/>
            </geometry>
        </visual>

        <collision>      
            <origin rpy="0 -${PI/2} ${PI/2}" xyz="0.1 0.0 0.5"/>
            <geometry>
                <box size="1.0 0.2 0.2"/>
            </geometry>
        </collision>
    </link>

    <joint name="joint_2" type="revolute"> 
        <parent link="base_plate"/>
        <child link="biceps_link"/>
        <axis xyz="1 0 0"/> 
        <origin rpy="0 0 0" xyz="0.08 0.0 0.20"/>
        <limit lower="-${PI/2}" upper="${PI/2}" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <link name="arm_link">
        <xacro:default_inertial_matrix mass="0.1"/>
        <visual>
            <origin rpy="${PI/2} 0 ${PI/2}" xyz="-0.101 0.5 0" />
            <geometry>
                <box size="1.0 0.2 0.2"/>
            </geometry>
        </visual>
        <collision>      
            <origin rpy="${PI/2} 0 ${PI/2}" xyz="-0.101 0.5 0" />
            <geometry>
                <box size="1.0 0.2 0.2"/>
            </geometry>
        </collision>
    </link>

    <joint name="joint_3" type="revolute">
        <parent link="biceps_link"/>
        <child link="arm_link"/>
        <axis xyz="1 0 0"/>
        <origin rpy="0 0 0" xyz="0 0 0.89"/>
        <limit lower="-${PI/2}" upper="${PI/2}" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <link name="wrist_link">  
        <xacro:default_inertial_matrix mass="0.1"/>
        <visual>
            <origin rpy="${PI/2} 0 ${PI/2}" xyz="0.101 0.5 0" />
            <geometry>
                <box size="1.0 0.2 0.2"/>
            </geometry>
        </visual>
        <collision>      
            <origin rpy="${PI/2} 0 ${PI/2}" xyz="0.101 0.5 0" />
            <geometry>
                <box size="1.0 0.2 0.2"/>
            </geometry>
        </collision>
    </link>
    
    <joint name="joint_4" type="revolute"> 
        <parent link="arm_link"/>
        <child link="wrist_link"/>
        <axis xyz="1 0 0"/>
        <origin rpy="0 0 0" xyz="0 0.6 0"/>
        <limit lower="-${PI/2}" upper="${PI/2}" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <link name="prismatic_link">  
        <xacro:default_inertial_matrix mass="0.05"/>
        <visual>
            <origin rpy="${PI/2} 0 ${PI/2}" xyz="-0.11 0.45 0" />
            <geometry>
                <box size="1.0 0.2 0.2"/>
            </geometry>
        </visual>
        <!-- for Gazebo -->
        <collision>      
            <origin rpy="0 0 ${PI/2}" xyz="-0.11 0.45 0" />
            <geometry>
                <box size="1.0 0.2 0.2"/>
            </geometry>
        </collision>
    </link>

    <joint name="joint_prism" type="prismatic">
        <parent link="wrist_link"/>
        <child link="prismatic_link"/>
        <axis xyz="0 1 0"/>
        <origin rpy="0 0 0" xyz="0 0.5 0"/>
        <limit lower="0.0" upper="0.50"
           effort="10.0" velocity="0.05"/>
    </joint>
  
    <link name="claw_link">  
        <xacro:default_inertial_matrix mass="0.05"/>
        <visual>
            <origin rpy="0 0 ${PI/2}" xyz="0 0.0 0.0" />
            <geometry>
                <box size="0.12 0.25 0.25"/>
            </geometry>
        </visual>

        <!-- for Gazebo -->
        <collision>      
            <!-- <origin rpy="0 0 ${PI/2}" xyz="0 -0.05 -0.15"/> -->
            <origin rpy="0 0 ${PI/2}" xyz="0 0.0 0.0" />
            <geometry>
                <!-- <mesh filename="package://roboarm_urdf_description/meshes/claw_support.STL" scale="0.01 0.01 0.01"/> -->
                <box size="0.12 0.25 0.25"/>
            </geometry>
        </collision>
    </link>

    <joint name="nuckles_joint" type="fixed">
        <parent link="prismatic_link"/>
        <child link="claw_link"/> 
        <origin rpy="0 0 0" xyz="-0.125 1.01 0"/>
    </joint>

    <!-- finger-->
    <link name="gripper_right">  
        <xacro:default_inertial_matrix mass="0.01"/>
        <visual>
            <origin rpy="0 0 -${PI/2}" xyz="-0.1 0.6 0.0"/>
            <geometry>
                <mesh filename="package://roboarm_urdf_description/meshes/right_finger.STL" scale="0.01 0.01 0.01"/>
            </geometry>
        </visual>
        <!-- for Gazebo -->
        <collision>      
            <origin rpy="0 0 -${PI/2}" xyz="-0.1 0.6 0.0"/>
            <geometry>
                <mesh filename="package://roboarm_urdf_description/meshes/right_finger.STL" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
    </link>
    
    <!--finger-->
    <link name="gripper_left">  
        <xacro:default_inertial_matrix mass="0.01"/>
        <visual>
            <origin rpy="0 0 -${PI/2}" xyz="-0.04 0.6 0.0"/>
            <geometry>
                <mesh filename="package://roboarm_urdf_description/meshes/left_finger.STL" scale="0.01 0.01 0.01"/>
            </geometry>
        </visual>

        <!-- for Gazebo -->
        <collision>      
           <origin rpy="0 0 -${PI/2}" xyz="-0.04 0.6 0.0"/>
            <geometry>
                <mesh filename="package://roboarm_urdf_description/meshes/left_finger.STL" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
    </link> 

    <!-- for gripperRight_joint -->
    <joint name="joint_5" type="revolute"> 
        <parent link="claw_link"/>
        <child link="gripper_right"/>
        <axis xyz="0 0 1"/>
        <origin rpy="0 0 0" xyz="+0.07 0.13 0.0"/>
        <limit lower="-${PI/2}" upper="0.0" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <!-- for gripperLeft_joint -->
    <joint name="joint_6" type="revolute"> 
        <parent link="claw_link"/>
        <child link="gripper_left"/>
        <axis xyz="0 0 1"/>
        <origin rpy="0 0 0" xyz="-0.09 0.13 0.0"/>
        <mimic joint="joint_5" multiplier="-1"/>  <!-- it mimics the right_gripper but in apposite way due to multiplier -1-->
        <limit lower="0" upper="${PI/2}" effort="${effort}" velocity="${velocity}"/>
    </joint>

</robot> 