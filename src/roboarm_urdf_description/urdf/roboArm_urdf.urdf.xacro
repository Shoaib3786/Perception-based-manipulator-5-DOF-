<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Robot_Arm" >

    <xacro:arg name="use_gazebo" default="true"/>

    <xacro:if value="$(arg use_gazebo)">
        <xacro:include filename="$(find roboarm_urdf_description)/urdf/roboArm_gazebo.xacro"/>
        <xacro:include filename="$(find roboarm_urdf_description)/urdf/roboArm_ros2_control.xacro"/>
    </xacro:if>    

    <!-- xacro:property is also variable - but for local use not like xacro:arg -->
    <xacro:property name="PI" value="3.141592653589793"/>
    <xacro:property name="effort" value="3.0"/>
    <xacro:property name="velocity" value="5.0"/>

    <!-- inertial matrix for Gazebo simulation for each link hence here as global varibale -->
    <xacro:macro name="default_inertial_matrix" params="mass">
        <inertial>
            <mass value="${mass}"/>
            <inertia 
                    ixx="1.0" ixy="0.0" ixz="0.0"
                    iyy="1.0" iyz="0.0"
                    izz="1.0"/>
        </inertial>
    </xacro:macro>

    <xacro:include filename="$(find roboarm_urdf_description)/urdf/roboArm_urdf_descript.urdf.xacro"/>

     
</robot> 