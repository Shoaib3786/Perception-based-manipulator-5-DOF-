<?xml version="1.0"?>

<sdf version="1.9">
  <world name="perception_world">

    <!-- ========================= -->
    <!-- WORLD SYSTEM PLUGINS      -->
    <!-- ========================= -->

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ========================= -->
    <!-- LIGHT                     -->
    <!-- ========================= -->

    <light type="directional" name="sun">
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.1 -0.9</direction>
    </light>

    <!-- ========================= -->
    <!-- GROUND                    -->
    <!-- ========================= -->

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>35 35</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>35 35</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.18 0.18 0.18 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================= -->
    <!-- BACK WALL                 -->
    <!-- ========================= -->

    <model name="back_wall">
      <static>true</static>
      <pose>7.5 0 2.25 0 0 0</pose>

      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 12.0 4.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 12.0 4.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.53 0.81 0.92 1</ambient>
            <diffuse>0.53 0.81 0.92 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================= -->
    <!-- LARGE TABLE WITH 4 LEGS   -->
    <!-- ========================= -->

    <model name="table">
      <static>true</static>
      <pose>1.5 0 0 0 0 0</pose>

      <link name="table_link">

        <!-- TABLE TOP -->
        <collision name="table_top_collision">
          <pose>0 0 0.98 0 0 0</pose>
          <geometry>
            <box>
              <size>6.0 4.5 0.12</size>
            </box>
          </geometry>
        </collision>

        <visual name="table_top_visual">
          <pose>0 0 0.98 0 0 0</pose>
          <geometry>
            <box>
              <size>6.0 4.5 0.12</size>
            </box>
          </geometry>
          <material>
            <ambient>0.50 0.35 0.20 1</ambient>
            <diffuse>0.55 0.38 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

        <!-- LEG 1 -->
        <collision name="leg1_collision">
          <pose>2.75 2.05 0.49 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.16 0.98</size>
            </box>
          </geometry>
        </collision>

        <visual name="leg1_visual">
          <pose>2.75 2.05 0.49 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.16 0.98</size>
            </box>
          </geometry>
          <material>
            <ambient>0.32 0.22 0.12 1</ambient>
            <diffuse>0.36 0.24 0.14 1</diffuse>
          </material>
        </visual>

        <!-- LEG 2 -->
        <collision name="leg2_collision">
          <pose>2.75 -2.05 0.49 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.16 0.98</size>
            </box>
          </geometry>
        </collision>

        <visual name="leg2_visual">
          <pose>2.75 -2.05 0.49 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.16 0.98</size>
            </box>
          </geometry>
          <material>
            <ambient>0.32 0.22 0.12 1</ambient>
            <diffuse>0.36 0.24 0.14 1</diffuse>
          </material>
        </visual>

        <!-- LEG 3 -->
        <collision name="leg3_collision">
          <pose>-2.75 2.05 0.49 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.16 0.98</size>
            </box>
          </geometry>
        </collision>

        <visual name="leg3_visual">
          <pose>-2.75 2.05 0.49 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.16 0.98</size>
            </box>
          </geometry>
          <material>
            <ambient>0.32 0.22 0.12 1</ambient>
            <diffuse>0.36 0.24 0.14 1</diffuse>
          </material>
        </visual>

        <!-- LEG 4 -->
        <collision name="leg4_collision">
          <pose>-2.75 -2.05 0.49 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.16 0.98</size>
            </box>
          </geometry>
        </collision>

        <visual name="leg4_visual">
          <pose>-2.75 -2.05 0.49 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.16 0.98</size>
            </box>
          </geometry>
          <material>
            <ambient>0.32 0.22 0.12 1</ambient>
            <diffuse>0.36 0.24 0.14 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- ========================= -->
    <!-- LARGER PERCEPTION OBJECT  -->
    <!-- ========================= -->

    <model name="red_cube">
      <pose>2.2 -0.5 1.18 0 0 0</pose>

      <link name="cube_link">
        <inertial>
          <mass>1.2</mass>
          <inertia>
            <ixx>0.01568</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.01568</iyy>
            <iyz>0</iyz>
            <izz>0.01568</izz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.28 0.28 0.28</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.28 0.28 0.28</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.10 0.10 1</ambient>
            <diffuse>0.95 0.10 0.10 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="pink_cube">
      <pose>3.2 1.2 1.18 0 0 0</pose>

      <link name="cube2_link">
        <inertial>
          <mass>1.2</mass>
          <inertia>
            <ixx>0.01568</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.01568</iyy>
            <iyz>0</iyz>
            <izz>0.01568</izz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.28 0.28 0.28</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.28 0.28 0.28</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.10 0.60 1</ambient>
            <diffuse>0.95 0.10 0.60 1</diffuse>
            <specular>0.10 0.10 0.60 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="green_cube">
      <pose>2.6 -1.5 1.18 0 0 0</pose>

      <link name="cube3_link">
        <inertial>
          <mass>1.2</mass>
          <inertia>
            <ixx>0.01568</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.01568</iyy>
            <iyz>0</iyz>
            <izz>0.01568</izz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.28 0.28 0.28</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.28 0.28 0.28</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.9 0.2 1</ambient>
            <diffuse>0.1 0.9 0.2 1</diffuse>
            <specular>0.9 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>